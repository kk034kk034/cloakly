require "base64"
require "spaceship"
require "tempfile"

opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Sign, build IPA, and upload to TestFlight"
  lane :internal do
    opt_out_usage
    setup_ci

    # Fastfile lives in apps/mobile/ios/fastlane
    ios_dir = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
    mobile_dir = File.expand_path("..", ios_dir)

    key_content = ENV.fetch("ASC_KEY_P8").dup
    key_content.force_encoding("UTF-8")
    key_content = key_content.sub(/\A\uFEFF/, "").strip
    UI.user_error!("ASC_KEY_P8 does not look like a PEM key") unless key_content.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID").sub(/\A\uFEFF/, "").strip,
      issuer_id: ENV.fetch("ASC_ISSUER_ID").sub(/\A\uFEFF/, "").strip,
      key_content: key_content,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    # setup_ci creates ".../fastlane_tmp_keychain-db" but KEYCHAIN_PATH omits "-db".
    keychain_path = File.expand_path(lane_context[SharedValues::KEYCHAIN_PATH].to_s)
    keychain_path = "#{keychain_path}-db" unless keychain_path.end_with?("-db")
    UI.user_error!("CI keychain missing at #{keychain_path}") unless File.exist?(keychain_path)

    if %w[1 true TRUE yes].include?(ENV["REVOKE_IOS_DIST_CERTS"].to_s)
      revoke_ios_distribution_certificates(api_key)
    end

    install_distribution_certificate!(
      api_key: api_key,
      keychain_path: keychain_path,
      ios_dir: ios_dir
    )

    sigh(
      api_key: api_key,
      app_identifier: "com.cloud52.cloakly",
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(ios_dir, "Runner.xcodeproj"),
      team_id: "2AMKWN2NTG",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: "com.cloud52.cloakly",
      targets: ["Runner"]
    )

    export_plist = File.join(ios_dir, "ExportOptions.ci.plist")
    File.write(
      export_plist,
      <<~PLIST
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
        	<key>method</key>
        	<string>app-store-connect</string>
        	<key>teamID</key>
        	<string>2AMKWN2NTG</string>
        	<key>signingStyle</key>
        	<string>manual</string>
        	<key>provisioningProfiles</key>
        	<dict>
        		<key>com.cloud52.cloakly</key>
        		<string>#{profile_name}</string>
        	</dict>
        	<key>uploadSymbols</key>
        	<true/>
        	<key>compileBitcode</key>
        	<false/>
        </dict>
        </plist>
      PLIST
    )
    UI.user_error!("ExportOptions missing at #{export_plist}") unless File.exist?(export_plist)

    Dir.chdir(mobile_dir) do
      sh(
        "flutter", "build", "ipa",
        "--release",
        "--dart-define-from-file=config/ci.json",
        "--export-options-plist=#{export_plist}"
      )
    end

    ipa = Dir[File.join(mobile_dir, "build", "ios", "ipa", "*.ipa")].first
    UI.user_error!("IPA not found under #{mobile_dir}/build/ios/ipa") if ipa.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload App Store metadata only. Does not upload an IPA or submit for review."
  lane :metadata do
    opt_out_usage

    ios_dir = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
    metadata_dir = File.join(ios_dir, "fastlane", "metadata")
    reject_unfilled_store_copy!(metadata_dir)
    reject_unfilled_store_copy!(File.expand_path("../../../../../docs/legal", metadata_dir))

    key_content = ENV.fetch("ASC_KEY_P8").dup
    key_content.force_encoding("UTF-8")
    key_content = key_content.sub(/\A\uFEFF/, "").strip
    UI.user_error!("ASC_KEY_P8 does not look like a PEM key") unless key_content.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID").sub(/\A\uFEFF/, "").strip,
      issuer_id: ENV.fetch("ASC_ISSUER_ID").sub(/\A\uFEFF/, "").strip,
      key_content: key_content,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    params = {
      api_key: api_key,
      app_identifier: "com.cloud52.cloakly",
      skip_binary_upload: true,
      skip_screenshots: ENV["UPLOAD_SCREENSHOTS"] != "1",
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      overwrite_screenshots: false,
      languages: ["en-US", "zh-Hant"]
    }
    version = ENV["IOS_APP_VERSION"].to_s.strip
    params[:app_version] = version unless version.empty?
    # deliver always fetches the App Store review detail while uploading
    # metadata. On the first version that record does not exist, and
    # spaceship raises "No data" from review_attachment_file. Passing
    # app_review_information makes deliver create the record first.
    # Once it exists, omit the hash so a later run does not set
    # demoAccountRequired back to false or replace console notes.
    if app_store_review_detail_missing?(version)
      params[:app_review_information] = app_store_review_contact
      UI.important("Creating App Store review contact with the support email. No demo password is sent.")
    end
    deliver(params)
  end
end

def revoke_ios_distribution_certificates(api_key)
  tmp = Tempfile.new(["AuthKey", ".p8"])
  begin
    tmp.write(api_key[:key])
    tmp.flush
    token = Spaceship::ConnectAPI::Token.create(
      key_id: api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      filepath: tmp.path
    )
    Spaceship::ConnectAPI.token = token

    types = %w[DISTRIBUTION IOS_DISTRIBUTION APPLE_DISTRIBUTION]
    certs = Spaceship::ConnectAPI::Certificate.all.select do |c|
      types.include?(c.certificate_type.to_s)
    end

    UI.important("Revoking #{certs.length} distribution certificate(s)")
    certs.each do |cert|
      UI.important("Revoking #{cert.id} (#{cert.certificate_type})")
      cert.delete!
    end
  ensure
    tmp.close!
  end
end

def install_distribution_certificate!(api_key:, keychain_path:, ios_dir:)
  p12_b64 = ENV["APPLE_CERT_P12_BASE64"].to_s.sub(/\A\uFEFF/, "").strip
  p12_password = ENV.fetch("APPLE_CERT_PASSWORD", "cloakly-ci-cert")

  if !p12_b64.empty?
    p12_path = File.join(ios_dir, "dist-import.p12")
    File.binwrite(p12_path, Base64.decode64(p12_b64.gsub(/\s+/, "")))
    import_certificate(
      certificate_path: p12_path,
      certificate_password: p12_password,
      keychain_path: keychain_path,
      keychain_password: ""
    )
    UI.success("Imported distribution certificate from APPLE_CERT_P12_BASE64")
    return
  end

  cert(
    api_key: api_key,
    keychain_path: keychain_path
  )

  # Persist identity for later CI runs (private key lives only in this job's keychain).
  p12_path = File.join(ios_dir, "dist-ci.p12")
  sh(
    "security", "export",
    "-k", keychain_path,
    "-t", "identities",
    "-f", "pkcs12",
    "-P", p12_password,
    "-o", p12_path
  )
  File.write(
    File.join(ios_dir, "dist-ci.p12.base64.txt"),
    Base64.strict_encode64(File.binread(p12_path))
  )
  UI.important("Exported dist-ci.p12 — set APPLE_CERT_P12_BASE64 + APPLE_CERT_PASSWORD=cloakly-ci-cert for stable CI")
end

# Contact and notes only. Never include a demo user or password.
# Name and phone are optional; App Store Connect accepts a review detail
# without them. They are still required before a human submits the version.
def app_store_review_contact
  info = {
    email_address: "contact@cloud-52.com",
    notes: <<~NOTES.strip
      Cloakly is an on-screen meeting assistant. It is not a hidden window.
      Sign-in is required. Enter the demo account in App Store Connect.
      The password is not stored in the repository.
      Support: contact@cloud-52.com.
    NOTES
  }
  {
    first_name: "ASC_REVIEW_FIRST_NAME",
    last_name: "ASC_REVIEW_LAST_NAME",
    phone_number: "ASC_REVIEW_PHONE"
  }.each do |key, env_name|
    value = ENV[env_name].to_s.strip
    info[key] = value unless value.empty?
  end
  info
end

def app_store_review_detail_missing?(version_string)
  app = Spaceship::ConnectAPI::App.find("com.cloud52.cloakly")
  UI.user_error!("Could not find App Store app com.cloud52.cloakly") if app.nil?

  version = if version_string.to_s.strip.empty?
              app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
            else
              app.get_app_store_versions(
                filter: {
                  platform: Spaceship::ConnectAPI::Platform::IOS,
                  versionString: version_string.strip
                },
                includes: nil
              ).first
            end
  return true if version.nil?

  begin
    version.fetch_app_store_review_detail
    false
  rescue StandardError => error
    message = error.message.to_s
    missing = ["No data", "NOT_FOUND", "does not exist"].any? { |needle| message.include?(needle) }
    if missing
      UI.important("No App Store review detail yet (#{message}).")
      true
    else
      UI.important("Could not check App Store review detail (#{message}). Leaving existing review contact information unchanged.")
      false
    end
  end
end

def reject_unfilled_store_copy!(root)
  hits = []
  Dir.glob(File.join(root, "**", "*")).each do |path|
    next unless File.file?(path)
    text = File.read(path)
    hits << path if text.include?("REPLACE_ME")
  end
  return if hits.empty?

  UI.user_error!(
    "Store copy still has REPLACE_ME placeholders. Fill them, then upload.\n#{hits.join("\n")}"
  )
end
