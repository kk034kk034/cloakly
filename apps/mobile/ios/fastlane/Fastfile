default_platform(:ios)

platform :ios do
  desc "Sign, build IPA, and upload to TestFlight"
  lane :internal do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8").sub(/\A\uFEFF/, ""),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    cert(api_key: api_key)
    sigh(
      api_key: api_key,
      app_identifier: "com.cloud52.cloakly",
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "2AMKWN2NTG",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: "com.cloud52.cloakly",
      targets: ["Runner"]
    )

    export_plist = File.expand_path("ExportOptions.ci.plist")
    File.write(
      export_plist,
      <<~PLIST
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
        	<key>method</key>
        	<string>app-store-connect</string>
        	<key>teamID</key>
        	<string>2AMKWN2NTG</string>
        	<key>signingStyle</key>
        	<string>manual</string>
        	<key>provisioningProfiles</key>
        	<dict>
        		<key>com.cloud52.cloakly</key>
        		<string>#{profile_name}</string>
        	</dict>
        	<key>uploadSymbols</key>
        	<true/>
        	<key>compileBitcode</key>
        	<false/>
        </dict>
        </plist>
      PLIST
    )

    Dir.chdir("..") do
      sh(
        "flutter", "build", "ipa",
        "--release",
        "--dart-define-from-file=config/ci.json",
        "--export-options-plist=ios/ExportOptions.ci.plist"
      )
    end

    ipa = Dir[File.expand_path("../build/ios/ipa/*.ipa")].first
    UI.user_error!("IPA not found") if ipa.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
