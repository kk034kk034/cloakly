default_platform(:ios)

platform :ios do
  desc "Sign, build IPA, and upload to TestFlight"
  lane :internal do
    opt_out_usage
    setup_ci

    # Fastfile lives in apps/mobile/ios/fastlane
    ios_dir = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
    mobile_dir = File.expand_path("..", ios_dir)

    key_content = ENV.fetch("ASC_KEY_P8").dup
    key_content.force_encoding("UTF-8")
    key_content = key_content.sub(/\A\uFEFF/, "").strip
    UI.user_error!("ASC_KEY_P8 does not look like a PEM key") unless key_content.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID").sub(/\A\uFEFF/, "").strip,
      issuer_id: ENV.fetch("ASC_ISSUER_ID").sub(/\A\uFEFF/, "").strip,
      key_content: key_content,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    # setup_ci creates ".../fastlane_tmp_keychain-db" but KEYCHAIN_PATH omits "-db".
    keychain_path = File.expand_path(lane_context[SharedValues::KEYCHAIN_PATH].to_s)
    keychain_path = "#{keychain_path}-db" unless keychain_path.end_with?("-db")
    UI.user_error!("CI keychain missing at #{keychain_path}") unless File.exist?(keychain_path)

    cert(
      api_key: api_key,
      keychain_path: keychain_path
    )
    sigh(
      api_key: api_key,
      app_identifier: "com.cloud52.cloakly",
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(ios_dir, "Runner.xcodeproj"),
      team_id: "2AMKWN2NTG",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: "com.cloud52.cloakly",
      targets: ["Runner"]
    )

    export_plist = File.join(ios_dir, "ExportOptions.ci.plist")
    File.write(
      export_plist,
      <<~PLIST
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
        	<key>method</key>
        	<string>app-store-connect</string>
        	<key>teamID</key>
        	<string>2AMKWN2NTG</string>
        	<key>signingStyle</key>
        	<string>manual</string>
        	<key>provisioningProfiles</key>
        	<dict>
        		<key>com.cloud52.cloakly</key>
        		<string>#{profile_name}</string>
        	</dict>
        	<key>uploadSymbols</key>
        	<true/>
        	<key>compileBitcode</key>
        	<false/>
        </dict>
        </plist>
      PLIST
    )
    UI.user_error!("ExportOptions missing at #{export_plist}") unless File.exist?(export_plist)
    UI.message("Wrote #{export_plist}")

    Dir.chdir(mobile_dir) do
      sh(
        "flutter", "build", "ipa",
        "--release",
        "--dart-define-from-file=config/ci.json",
        "--export-options-plist=#{export_plist}"
      )
    end

    ipa = Dir[File.join(mobile_dir, "build", "ios", "ipa", "*.ipa")].first
    UI.user_error!("IPA not found under #{mobile_dir}/build/ios/ipa") if ipa.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
