opt_out_usage

default_platform(:android)

platform :android do
  desc "Upload Play listing metadata only. Does not upload an AAB or send the edit for review."
  lane :metadata do
    opt_out_usage

    android_dir = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
    metadata_dir = File.join(android_dir, "fastlane", "metadata")
    reject_unfilled_store_copy!(metadata_dir)
    reject_unfilled_store_copy!(File.expand_path("../../../../../docs/legal", metadata_dir))

    upload_images = ENV["UPLOAD_SCREENSHOTS"] == "1"
    # Listing text is global. This lane uploads no AAB, so supply has no
    # version code. supply 2.241.1 then calls upload_changelog and fails with
    # "Cannot find changelog because no version code given". Skip changelogs.
    # Title, short description, and full description still upload. The internal
    # track must already have exactly one release (from Mobile Internal
    # Release); supply looks that release up before writing the listing.
    # changelogs/default.txt stays in git for a later binary upload.
    upload_to_play_store(
      json_key: play_json_key_path,
      package_name: "com.cloud52.cloakly",
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: !upload_images,
      skip_upload_screenshots: !upload_images,
      sync_image_upload: false,
      changes_not_sent_for_review: true
    )
  end
end

def reject_unfilled_store_copy!(root)
  hits = []
  Dir.glob(File.join(root, "**", "*")).each do |path|
    next unless File.file?(path)
    text = File.read(path)
    hits << path if text.include?("REPLACE_ME")
  end
  return if hits.empty?

  UI.user_error!(
    "Store copy still has REPLACE_ME placeholders. Fill them, then upload.\n#{hits.join("\n")}"
  )
end

def play_json_key_path
  raw = ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON").dup
  raw.force_encoding("UTF-8")
  raw = raw.sub(/\A\uFEFF/, "").strip
  UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON is empty") if raw.empty?
  UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON does not look like JSON") unless raw.include?("{")

  path = File.join(Dir.tmpdir, "cloakly-play-service-account.json")
  File.write(path, raw)
  File.chmod(0o600, path)
  path
end
